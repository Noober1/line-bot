# LINE Messaging API (LINE Developers Console > channel > Messaging API tab)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# HTTP port (optional, default 3000)
PORT=3000

# Access (see README "Access"). Groups are allowed by the user who asked for them, with /approve in a DM to the bot.
# Optional: your own LINE user ID (LINE Developers Console > channel > Basic settings > "Your user ID", U + 32 hex characters).
# The owner chats with the AI in a DM, can use the bot in every group and manages every group. Empty = no owner.
OWNER_USER_ID=
# Allowed groups one user may be the admin of at the same time (optional, default 3, whole number above 0). The owner has no limit.
MAX_GROUPS_PER_USER=3

# SQLite file for chat history (optional, default bot.sqlite in the working directory).
# The folder must exist; the file is created on first start.
# Keep the .sqlite extension (git-ignored) or put the file outside the repo.
DATABASE_PATH=bot.sqlite

# AI backend: 9router (https://github.com/decolua/9router), an OpenAI-compatible gateway.
# Required. A 9router combo name (Dashboard > Combos) or provider/model, e.g. cc/claude-opus-4-7.
AI_MODEL=
# Optional, default http://localhost:20128/v1. Must be https://, except http:// on localhost, 127.0.0.1 or [::1].
AI_BASE_URL=http://localhost:20128/v1
# Optional. Only needed when 9router runs with REQUIRE_API_KEY=true (copy the key from its dashboard).
AI_API_KEY=

# Default target language of /translate (optional, default en). ISO 639-1 code: en, id, ja, ko, zh, ...
# Used only when the user has no /config value and their LINE language is unknown.
DEFAULT_TRANSLATE_LANG=en

# Language of the bot's own replies (/help, /config, errors) when the user's LINE app language
# is unknown or not one of: id, en, ja, zh-Hans, zh-Hant. Optional, default id.
DEFAULT_REPLY_LANG=id

# Messages per minute the bot handles per chat (a user, or a whole group or room). Optional, default 10, 0 = no limit.
# The first message over the limit gets a short notice; the rest of that minute get no reply.
RATE_LIMIT_PER_MINUTE=10

# Lowest log level printed to the terminal: debug, info, warn or error. Optional, default info.
# info logs what happens to each event but never message text; debug adds message text (cut to 200 characters) and full IDs.
LOG_LEVEL=info
