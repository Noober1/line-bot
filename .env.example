# LINE Messaging API (LINE Developers Console > channel > Messaging API tab)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# HTTP port (optional, default 3000)
PORT=3000

# Allowlist (optional, comma-separated). Events from anyone else are ignored.
# Empty = the bot ignores everything. Ignored events are logged with their IDs.
# Your own user ID: LINE Developers Console > channel > Basic settings > "Your user ID".
ALLOWED_USER_IDS=
# Group and multi-person chat (room) IDs. Invite the bot, then copy the ID from the
# "Ignored join event from group ..." log line.
ALLOWED_GROUP_IDS=
